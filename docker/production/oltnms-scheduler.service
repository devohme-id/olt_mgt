[Unit]
Description=OLT NMS — Laravel Scheduler (Cron)
After=postgresql.service redis-server.service

[Service]
User=oltnms
Group=oltnms
WorkingDirectory=/var/www/oltnms
ExecStart=/usr/bin/php artisan schedule:work
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/www/oltnms/storage /var/www/oltnms/bootstrap/cache

[Install]
WantedBy=multi-user.target
