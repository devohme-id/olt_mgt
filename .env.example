APP_NAME="OLT NMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nms.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database (PostgreSQL + TimescaleDB) ──
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=olt_nms
DB_USERNAME=oltnms
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Session ──
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Broadcasting (Reverb WebSocket) ──
BROADCAST_CONNECTION=reverb

# ── Queue (Redis via Horizon) ──
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

# ── Cache (Redis) ──
CACHE_STORE=redis

# ── Redis ──
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379

# ── Mail ──
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.yourdomain.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nms@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Reverb WebSocket ──
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="0.0.0.0"
REVERB_PORT=8080
REVERB_SCHEME=https

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="nms.yourdomain.com"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Telegram Bot (Alarm Notifications) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
